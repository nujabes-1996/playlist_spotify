# Configuration du déploiement prod — copier en .env.prod et adapter.
# (Aucun credential Spotify ici : chaque utilisateur les saisit sur l'écran de connexion.)

# Domaine pointant vers l'IP de ton serveur (enregistrement DNS A / AAAA).
DOMAIN=playlist.mondomaine.fr

# Email de contact Let's Encrypt — recommandé (alertes d'expiration de certificat).
ACME_EMAIL=toi@exemple.fr

# Secret de signature du cookie de session. OBLIGATOIRE en prod : sans lui (ou avec la
# valeur de dev), le backend refuse de démarrer. Le cookie est signé, pas chiffré — une
# clé connue permettrait de forger une session et d'usurper n'importe quel compte.
# Générer une valeur forte et aléatoire :
#   openssl rand -hex 32
# Ne JAMAIS committer une vraie valeur (.env.prod est gitignoré ; ce fichier est un exemple).
SESSION_SECRET=
